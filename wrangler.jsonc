{
  "name": "node-fetch",
  "main": "worker.js",
  "triggers": { "crons": ["17 * * * *"] },
  "assets": {
    "directory": ".open-next/assets"
  },
  "compatibility_date": "2025-05-05",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "observability": {
    "logs": {
      "enabled": true
    }
  }
}
